# Copy to .env and fill in. Never commit .env.

# Arc testnet (chain ID 5042002). Check https://docs.arc.io if the hosts change.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app

# The network wallet: deploys the contracts and becomes their owner.
# The backend uses the same key as NETWORK_PRIVATE_KEY to issue rewards.
# Fund it with test USDC from https://faucet.circle.com (USDC is also the gas token).
DEPLOYER_PRIVATE_KEY=

# USDC ERC-20 interface on Arc (6 decimals). Leave as is for Arc testnet.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# The two operators of the demo brand. Slugs must match backend/brands.json.
BRAND_US_SLUG=brand-a-us
BRAND_SG_SLUG=cafe-sg
# Where each operator is paid. Use two fresh addresses you control, not the deployer.
US_SETTLEMENT=
SG_SETTLEMENT=

# Reward budgets deposited at deploy time, in USDC units (1000000 = $1.00).
# Leave at 0 and let the backend seed script fund them if faucet USDC is tight.
FUND_US_USDC=0
FUND_SG_USDC=0
