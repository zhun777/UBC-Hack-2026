# Copy this file to .env and fill in your own values. Never commit .env.

# fake = no blockchain; points are kept in SQLite. Use this until the contracts are deployed.
# arc  = the real APPToken and RewardsVault on Arc testnet (reads contracts/deployments.json).
CHAIN_MODE=fake

# test   = the backend makes one key per user and keeps it in SQLite (test only).
# circle = Circle developer-controlled wallets (not wired up yet).
WALLET_MODE=test

# Arc testnet RPC URL. Leave blank to use rpcUrl from contracts/deployments.json.
RPC_URL=

# The network wallet: the RewardsVault owner. It sends issueReward and its test USDC
# backs every reward. Make one with: python scripts/new_network_wallet.py
NETWORK_PRIVATE_KEY=

# Circle developer-controlled wallets (only needed for WALLET_MODE=circle).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Fixed demo exchange rate. Add <CURRENCY>_PER_USD for any other currency.
SGD_PER_USD=1.35

# Optional. Defaults shown.
MIN_POINTS_TO_SPEND=100
GAS_TOPUP_CENTS=20
WATCHER_INTERVAL_SECONDS=2
CORS_ORIGINS=*
